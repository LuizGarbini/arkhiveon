{
  "name": "arkhiveon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 127.0.0.1",
    "build": "vite build --configLoader runner && tsc",
    "serve": "vite preview",
    "test": "vitest run --configLoader runner",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:link": "supabase link --project-ref",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types --lang=typescript --linked --schema public > src/lib/database.types.ts",
    "db:types:local": "supabase gen types --lang=typescript --local --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-beta.7",
    "@base-ui/react": "^1.0.0",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "shadcn": "^3.6.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "supabase": "^2.98.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
