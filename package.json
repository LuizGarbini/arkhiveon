{
  "name": "arkhiveon",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --port 3000 --host 127.0.0.1",
    "build": "vite build --configLoader runner && tsc",
    "serve": "vite preview",
    "test": "vitest run --configLoader runner",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:link": "supabase link --project-ref",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types --lang=typescript --linked --schema public > src/lib/database.types.ts",
    "db:types:local": "supabase gen types --lang=typescript --local --schema public > src/lib/database.types.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "preview:record": "npx tsx scripts/record-preview.ts"
  },
